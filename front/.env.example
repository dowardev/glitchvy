# Frontend env template - Glitchvy admin SPA
# Copy to .env.local (development) or .env.production (production) and adjust.
# Only the VITE_* variables are exposed to the bundle; Vite bakes them at
# build time, so a rebuild is required after changing them.

# Base URL of the Glitchvy API.
# Same host (SPA and API served together) => "/api" (the default).
# Split deployment (SPA on another host) => "https://errors.example.com/api"
VITE_GLITCHVY_API_URL=/api

# Content-Security-Policy connect-src sources of the built bundle.
# Keep "'self'" when the SPA calls the API on the same origin.
VITE_GLITCHVY_CSP_CONNECT_SRC='self'
