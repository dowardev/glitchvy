# Frontend env template (development) - Glitchvy admin SPA
# Copy to .env.local. The Vite dev server proxies /api to the backend, so the
# SPA can call the API without CORS.

VITE_GLITCHVY_API_URL=/api

# Dev server proxy target (the Laravel backend).
VITE_GLITCHVY_PROXY_TARGET=http://localhost:8000

VITE_GLITCHVY_CSP_CONNECT_SRC='self'
