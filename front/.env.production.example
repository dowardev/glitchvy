# Frontend env template (production) - Glitchvy admin SPA
# Copy to .env.production. Vite bakes these values into the bundle at build
# time: rebuild the SPA after changing them.

# The API is served from its own subdomain, so the URL is absolute. A
# deployment with the API in the same origin uses "/api" instead.
VITE_GLITCHVY_API_URL=https://glitchvy-backend.dowar.xyz/api

# The browser only connects to the origin of the API and to its own.
VITE_GLITCHVY_CSP_CONNECT_SRC="'self' https://glitchvy-backend.dowar.xyz"
