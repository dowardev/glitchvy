# Apache rules for the Glitchvy admin SPA.
#
# The SPA is a single page application built with the history mode of
# the router: every route is served by index.html, otherwise a reload on
# /login (or on any project route) answers with a 404.
#
# The Laravel application is deployed to back/, inside this same
# document root, so the API is routed to it: the SPA calls /api on its
# own origin and the Sanctum session cookie belongs to that origin.
# The rules are skipped when there is no application in back/, which is
# the case when the API is served from another subdomain.

RewriteEngine On

# The API, the Sanctum endpoints and the stored files belong to the
# Laravel application.
RewriteCond %{DOCUMENT_ROOT}/back/public/index.php -f
RewriteCond %{REQUEST_URI} !^/back/
RewriteRule ^api(/.*)?$ back/public/api$1 [L]
RewriteRule ^sanctum(/.*)?$ back/public/sanctum$1 [L]
RewriteRule ^storage(/.*)?$ back/public/storage$1 [L]

# SPA: serve index.html for any route that is not a real file/directory
# so client-side navigation (Vue Router history mode) survives a refresh.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/back/
RewriteRule . /index.html [L]
