# .env.example - glitchvy deploy
# Copy this file to .env (in scripts/deploy/) and fill in your server values.
# THIS FILE IS COMMITTED - NEVER PUT REAL SECRETS HERE.
# The real .env is gitignored.
#
# The same variables are used by the GitLab CI deploy stage
# (SSH_HOST, SSH_PORT, SSH_USER, DEPLOY_PATH_BACKEND, DEPLOY_PATH_FRONTEND).

# ============================================================
# SSH Connection (matching the GitLab CI/CD variables)
# ============================================================
SSH_HOST=195.179.236.189
SSH_PORT=65002
SSH_USER=u902881280

# Option A: key content (GitLab CI style) - paste the whole private key
# SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
# ...
# -----END OPENSSH PRIVATE KEY-----"

# Option B: path to a local key file (alternative)
# SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa

# Optional: known_hosts content (GitLab CI style)
# SSH_KNOWN_HOSTS="195.179.236.189 ssh-rsa AAAAB3NzaC1yc2E..."

# ============================================================
# Remote Deploy Paths (glitchvy)
# ============================================================
# The Laravel app (its document root is back/public).
DEPLOY_PATH_BACKEND=/home/u902881280/public_html/subdomains/glitchvy/back

# The admin SPA: the contents of front/dist/ are extracted here.
DEPLOY_PATH_FRONTEND=/home/u902881280/public_html/subdomains/glitchvy
