{
  "name": "@dowardev/glitchvy",
  "version": "0.2.0",
  "description": "Minimalist error reporter SDK. Framework-agnostic. POSTs errors to your glitchvy SaaS ingestion URL.",
  "license": "AGPL-3.0-only",
  "author": "DowarDev",
  "homepage": "https://gitlab.com/dowardev/glitchvy",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/dowardev/glitchvy.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://gitlab.com/dowardev/glitchvy/-/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "sideEffects": false,
  "keywords": [
    "error-reporter",
    "error-tracking",
    "agpl",
    "dowar",
    "framework-agnostic",
    "saas"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.8"
  },
  "spdx": {
    "copyright": "2026 DowarDev",
    "license": "AGPL-3.0-only"
  }
}
